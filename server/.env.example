PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_TTL_SECONDS=86400
# Set this to the same Firebase project ID as the frontend. VITE_FIREBASE_PROJECT_ID is also accepted.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE_ID=(default)
# Local development: path to a private Firebase service-account JSON file (use forward slashes on Windows).
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/lumera-firebase-admin.json
# Configure Firebase Admin credentials through Application Default Credentials.
# Optional TURN support for restrictive networks:
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
# Optional first agent account. Password is hashed before it is stored.
BOOTSTRAP_AGENT_EMAIL=
BOOTSTRAP_AGENT_PASSWORD=
ADMIN_EMAILS=sgahimbare20@gmail.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
